[clamp_player_viewport
  // Fixed projection, depth-dependent world boundary. The craft cannot leave
  // the visible viewport just because it moves nearer to the unchanged camera.
  movem.l d0-d2,-(sp)
  moveq #0,d0.l
  move.w player_z.l,d0.w
  addi.w #140,d0.w
  muls.w #12551,d0.l
  addi.l #1263720,d0.l
  asr.l #7,d0.l
  asr.l #7,d0.l
  mulu.w #160,d0.l
  divu.w #310,d0.l
  cmpi.w #180,d0.w
  ble.s .positive
  move.w #180,d0.w
.positive:
  cmp.w player_x.l,d0.w
  bge.s .negative
  move.w d0.w,player_x.l
.negative:
  neg.w d0.w
  cmp.w player_x.l,d0.w
  ble.s .done
  move.w d0.w,player_x.l
.done:
  movem.l (sp)+,d0-d2
]
[mark_image_rect
  movem.l d0-d7/a0,-(sp)
  sub.w d2.w,d0.w
  sub.w d2.w,d1.w
  move.w d0.w,d3.w
  move.w d1.w,d4.w
  add.w (a0),d0.w
  add.w 2(a0),d1.w
  add.w 4(a0),d3.w
  add.w 6(a0),d4.w
  subq.w #1,d3.w
  subq.w #1,d4.w
  tst.w d0.w
  bge.s .x0
  clr.w d0.w
.x0:
  cmpi.w #64,d1.w
  bge.s .y0
  move.w #64,d1.w
.y0:
  cmpi.w #511,d3.w
  ble.s .x1
  move.w #511,d3.w
.x1:
  cmpi.w #447,d4.w
  ble.s .y1
  move.w #447,d4.w
.y1:
  cmp.w d3.w,d0.w
  bgt.w .done
  cmp.w d4.w,d1.w
  bgt.w .done
  subi.w #64,d1.w
  subi.w #64,d4.w
  lsr.w #4,d0.w
  lsr.w #4,d3.w
  lsr.w #4,d1.w
  lsr.w #4,d4.w
  move.l #TILE_DIRTY,a0
  tst.w draw_page.l
  beq.s .row
  adda.w #768,a0
.row:
  move.w d1.w,d5.w
  lsl.w #5,d5.w
  add.w d0.w,d5.w
  move.w d3.w,d6.w
  sub.w d0.w,d6.w
.column:
  move.b #1,0(a0,d5.w)
  addq.w #1,d5.w
  dbra d6.w,.column
  addq.w #1,d1.w
  cmp.w d4.w,d1.w
  ble.s .row
.done:
  movem.l (sp)+,d0-d7/a0
]
[sync_object_damage
  move.l #PAGE_OBJECTS,a5
  tst.w draw_page.l
  beq.s .page
  adda.w #168,a5
.page:
  move.l #OBJS,a6
  move.l #IMAGE_GENERATIONS,a4
  lea image_descriptors(pc),a3
  moveq #6,d7.l
.object:
  moveq #0,d6.l
.compare:
  move.w 0(a5,d6.w),d0.w
  cmp.w 0(a6,d6.w),d0.w
  bne.s .changed
  addq.w #2,d6.w
  cmpi.w #12,d6.w
  blt.s .compare
  move.w (a4),d0.w
  cmp.w 12(a5),d0.w
  beq.s .next
.changed:
  move.w 8(a3),d2.w
  tst.w 10(a5)
  beq.s .new
  tst.w 6(a5)
  bmi.s .new
  move.w (a5),d0.w
  move.w 2(a5),d1.w
  lea 16(a5),a0
  bsr.w mark_image_rect
.new:
  tst.w 10(a6)
  beq.s .save
  tst.w 6(a6)
  bmi.s .save
  move.w (a6),d0.w
  move.w 2(a6),d1.w
  move.w #6,d3.w
  sub.w d7.w,d3.w
  lsl.w #3,d3.w
  move.l #IMAGE_BOUNDS,a0
  adda.w d3.w,a0
  bsr.w mark_image_rect
.save:
  move.l (a6),(a5)
  move.l 4(a6),4(a5)
  move.l 8(a6),8(a5)
  move.w (a4),12(a5)
  move.w #6,d3.w
  sub.w d7.w,d3.w
  lsl.w #3,d3.w
  move.l #IMAGE_BOUNDS,a0
  adda.w d3.w,a0
  move.l (a0),16(a5)
  move.l 4(a0),20(a5)
.next:
  adda.w #24,a5
  adda.w #16,a6
  addq.l #2,a4
  adda.w #12,a3
  dbra d7.w,.object
]
[record_image_bounds
  move.w render_slot.l,d0.w
  lsl.w #3,d0.w
  move.l #IMAGE_BOUNDS,a2
  adda.w d0.w,a2
  move.w render_size.l,(a2)
  move.w render_size.l,2(a2)
  clr.l 4(a2)
  move.l dirty_left_pointer.l,a0
  move.l dirty_right_pointer.l,a1
  moveq #0,d6.l
  move.w render_size.l,d7.w
  subq.w #1,d7.w
.row:
  move.w (a0)+,d0.w
  move.w (a1)+,d1.w
  cmp.w d1.w,d0.w
  bge.s .next
  cmp.w (a2),d0.w
  bge.s .top
  move.w d0.w,(a2)
.top:
  cmp.w 2(a2),d6.w
  bge.s .right
  move.w d6.w,2(a2)
.right:
  cmp.w 4(a2),d1.w
  ble.s .bottom
  move.w d1.w,4(a2)
.bottom:
  move.w d6.w,d0.w
  addq.w #1,d0.w
  move.w d0.w,6(a2)
.next:
  addq.w #1,d6.w
  dbra d7.w,.row
]
[copy_background_tile
  movem.l d0-d7/a0-a3,-(sp)
  move.w d0.w,d2.w
  lsr.w #5,d2.w
  lsl.w #4,d2.w
  addi.w #64,d2.w
  mulu.w #1024,d2.l
  andi.w #31,d0.w
  lsl.w #5,d0.w
  add.l d0.l,d2.l
  move.l composite_page.l,a0
  adda.l d2.l,a0
  tst.w d1.w
  beq.w .blank
  lsl.l #5,d1.l
  move.l #$10000,a2
  cmpi.l #$60000,d1.l
  blt.s .dictionary
  subi.l #$60000,d1.l
  move.l #$b6000,a2
.dictionary:
  adda.l d1.l,a2
  lea background_pair_lut(pc),a3
  lea 1024(a0),a1
  moveq #7,d7.l
.row:
  moveq #3,d6.l
.pair:
  moveq #0,d0.l
  move.b (a2)+,d0.b
  lsl.w #3,d0.w
  move.l 0(a3,d0.w),d1.l
  move.l 4(a3,d0.w),d2.l
  move.l d1.l,(a0)+
  move.l d2.l,(a0)+
  move.l d1.l,(a1)+
  move.l d2.l,(a1)+
  dbra d6.w,.pair
  adda.w #2016,a0
  adda.w #2016,a1
  dbra d7.w,.row
  bra.s .done
.blank:
  moveq #0,d0.l
  moveq #15,d7.l
.blank_row:
  move.l d0.l,(a0)+
  move.l d0.l,(a0)+
  move.l d0.l,(a0)+
  move.l d0.l,(a0)+
  move.l d0.l,(a0)+
  move.l d0.l,(a0)+
  move.l d0.l,(a0)+
  move.l d0.l,(a0)+
  adda.w #992,a0
  dbra d7.w,.blank_row
.done:
  movem.l (sp)+,d0-d7/a0-a3
]
[quality_state
render_budget:
  defw 0
drawing_size:
  defw 64
drawing_stride:
  defw 128
drawing_center:
  defw 32
]/
[transform_vertices
  movem.l d0-d7/a0-a4,-(sp)
  lea sine_table(pc),a2
  move.w #$7fff,current_min_x.l
  move.w #$8000,current_max_x.l
  move.w #$7fff,current_min_y.l
  move.w #$8000,current_max_y.l

  move.w current_angle.l,d0.w
  andi.w #$00ff,d0.w
  add.w d0.w,d0.w
  move.w 0(a2,d0.w),d4.w       // yaw sine
  addi.w #128,d0.w
  andi.w #$01ff,d0.w
  move.w 0(a2,d0.w),d5.w       // yaw cosine

  move.w #10531,d6.w
  move.w #12551,d7.w

  move.l render_model.l,a0
  lea projected_vertices(pc),a1
  move.w render_vertex_count.l,vertices_left.l
.vertex:
  bsr.w service
  move.w (a0)+,tmp_x.l
  move.w (a0)+,tmp_y.l
  move.w (a0)+,tmp_z.l

  // yaw: x1 = (x*cos + z*sin) >> 14
  move.w tmp_x.l,d0.w
  muls.w d5.w,d0.l
  move.w tmp_z.l,d1.w
  muls.w d4.w,d1.l
  add.l d1.l,d0.l
  asr.l #7,d0.l
  asr.l #7,d0.l
  move.w d0.w,tmp_x1.l

  // yaw: z1 = (z*cos - x*sin) >> 14
  move.w tmp_z.l,d0.w
  muls.w d5.w,d0.l
  move.w tmp_x.l,d1.w
  muls.w d4.w,d1.l
  sub.l d1.l,d0.l
  asr.l #7,d0.l
  asr.l #7,d0.l
  move.w d0.w,tmp_z1.l

  // pitch: y2 = (y*cos - z1*sin) >> 14
  move.w tmp_y.l,d0.w
  muls.w d7.w,d0.l
  move.w tmp_z1.l,d1.w
  muls.w d6.w,d1.l
  sub.l d1.l,d0.l
  asr.l #7,d0.l
  asr.l #7,d0.l
  move.w d0.w,tmp_y2.l

  // pitch: z2 = (y*sin + z1*cos) >> 14
  move.w tmp_y.l,d0.w
  muls.w d6.w,d0.l
  move.w tmp_z1.l,d1.w
  muls.w d7.w,d1.l
  add.l d1.l,d0.l
  asr.l #7,d0.l
  asr.l #7,d0.l
  move.w d0.w,pose_rotated_z.l
  add.w pose_depth.l,d0.w
  cmpi.w #64,d0.w
  bge.w .safe_depth
  move.w #1,pose_invalid.l
  move.w #64,d0.w
.safe_depth:
  move.w d0.w,tmp_depth.l

  // Square-pixel correction: identical X/Y focal lengths for the 512x512 frame.
  move.w tmp_x1.l,d1.w
  muls.w #310,d1.l
  move.w pose_view_x.l,d2.w
  muls.w pose_rotated_z.l,d2.l
  sub.l d2.l,d1.l
  divs.w d0.w,d1.l
  add.w local_center.l,d1.w
  move.w d1.w,(a1)+
  cmp.w current_min_x.l,d1.w
  bge.s .min_x_ok
  move.w d1.w,current_min_x.l
.min_x_ok:
  cmp.w current_max_x.l,d1.w
  ble.s .max_x_ok
  move.w d1.w,current_max_x.l
.max_x_ok:

  move.w tmp_y2.l,d1.w
  muls.w #310,d1.l
  move.w pose_view_y.l,d2.w
  muls.w pose_rotated_z.l,d2.l
  sub.l d2.l,d1.l
  divs.w d0.w,d1.l
  add.w local_center.l,d1.w
  move.w d1.w,(a1)+
  cmp.w current_min_y.l,d1.w
  bge.s .min_y_ok
  move.w d1.w,current_min_y.l
.min_y_ok:
  cmp.w current_max_y.l,d1.w
  ble.s .max_y_ok
  move.w d1.w,current_max_y.l
.max_y_ok:
  move.w d0.w,(a1)+

  subq.w #1,vertices_left.l
  bne.w .vertex
  movem.l (sp)+,d0-d7/a0-a4
]

[build_face_order
  movem.l d0-d7/a0-a2,-(sp)
  move.l render_faces.l,a0
  lea projected_vertices(pc),a1
  lea face_order(pc),a2
  clr.w STATUS_VISIBLE_FACES.l
  moveq #0,d7.l
.face:
  bsr.w service
  // Index * 6 using word additions, without three MULU instructions.
  move.w (a0)+,d0.w
  move.w d0.w,d3.w
  add.w d0.w,d0.w
  add.w d3.w,d0.w
  add.w d0.w,d0.w
  move.w (a0)+,d1.w
  move.w d1.w,d3.w
  add.w d1.w,d1.w
  add.w d3.w,d1.w
  add.w d1.w,d1.w
  move.w (a0)+,d2.w
  move.w d2.w,d3.w
  add.w d2.w,d2.w
  add.w d3.w,d2.w
  add.w d2.w,d2.w
  addq.l #2,a0
  // Identical signed 32-bit screen cross, before depth sorting.
  move.w 0(a1,d1.w),d3.w
  sub.w 0(a1,d0.w),d3.w
  move.w 2(a1,d2.w),d4.w
  sub.w 2(a1,d0.w),d4.w
  muls.w d4.w,d3.l
  move.w 0(a1,d2.w),d5.w
  sub.w 0(a1,d0.w),d5.w
  move.w 2(a1,d1.w),d6.w
  sub.w 2(a1,d0.w),d6.w
  muls.w d6.w,d5.l
  sub.l d5.l,d3.l
  ble.s .skip
  move.w 4(a1,d0.w),d3.w
  add.w 4(a1,d1.w),d3.w
  add.w 4(a1,d2.w),d3.w
  move.w d3.w,(a2)+
  move.w d7.w,(a2)+
  addq.w #1,STATUS_VISIBLE_FACES.l
.skip:
  addq.w #1,d7.w
  cmp.w render_face_count.l,d7.w
  bne.w .face
  movem.l (sp)+,d0-d7/a0-a2
]

// Stable descending insertion sort: far faces first, ties keep model order.
[sort_face_order
  movem.l d0-d2/d5-d7/a0-a1,-(sp)
  lea face_order+4(pc),a0
  moveq #1,d5.l
  move.w STATUS_VISIBLE_FACES.l,d7.w
  subq.w #2,d7.w
  bmi.s .done
.insert:
  move.l (a0),d0.l
  move.w (a0),d1.w
  move.w d5.w,d2.w
  move.l a0,a1
.shift:
  bsr.w service
  cmp.w -4(a1),d1.w
  ble.s .place
  move.l -4(a1),(a1)
  subq.l #4,a1
  subq.w #1,d2.w
  bne.s .shift
.place:
  move.l d0.l,(a1)
  addq.l #4,a0
  addq.w #1,d5.w
  dbra d7.w,.insert
.done:
  movem.l (sp)+,d0-d2/d5-d7/a0-a1
]

[draw_faces
  movem.l d0-d7/a0-a4,-(sp)
  lea face_order(pc),a0
  move.w STATUS_VISIBLE_FACES.l,faces_left.l
  beq.w .done
.face:
  bsr.w service
  move.w 2(a0),d0.w
  lsl.w #3,d0.w
  move.l render_faces.l,a2
  lea 0(a2,d0.w),a2
  lea projected_vertices(pc),a1
  lea triangle_points(pc),a3

  move.w (a2)+,d0.w
  bsr.w copy_projected_xy
  move.w (a2)+,d0.w
  bsr.w copy_projected_xy
  move.w (a2)+,d0.w
  bsr.w copy_projected_xy
  move.w (a2),triangle_color.l
  ori.w #256,triangle_color.l

  bsr.w raster_triangle
.skip:
  addq.l #4,a0
  subq.w #1,faces_left.l
  bne.w .face
.done:
  movem.l (sp)+,d0-d7/a0-a4
]

// d0=index, a1=projected base, a3=destination; all other state preserved by caller.
[copy_projected_xy
  move.w d0.w,d4.w
  add.w d0.w,d0.w
  add.w d4.w,d0.w
  add.w d0.w,d0.w
  lea 0(a1,d0.w),a4
  move.w (a4)+,(a3)+
  move.w (a4),(a3)+
]

// d0 = signed 32-bit screen-space cross product.
[cull_triangle
  move.w triangle_points+4.l,d0.w
  sub.w triangle_points.l,d0.w
  move.w triangle_points+10.l,d1.w
  sub.w triangle_points+2.l,d1.w
  muls.w d1.w,d0.l

  move.w triangle_points+8.l,d2.w
  sub.w triangle_points.l,d2.w
  move.w triangle_points+6.l,d3.w
  sub.w triangle_points+2.l,d3.w
  muls.w d3.w,d2.l
  sub.l d2.l,d0.l
]

[raster_triangle
  movem.l d0-d7/a0-a3,-(sp)
  move.w triangle_points.l,raster_x0.l
  move.w triangle_points+2.l,raster_y0.l
  move.w triangle_points+4.l,raster_x1.l
  move.w triangle_points+6.l,raster_y1.l
  move.w triangle_points+8.l,raster_x2.l
  move.w triangle_points+10.l,raster_y2.l

  // Three compare/swaps sort complete (x,y) pairs by ascending Y.
  move.w raster_y0.l,d0.w
  cmp.w raster_y1.l,d0.w
  ble.s .pair_01_ok
  move.w raster_y1.l,d1.w
  move.w d1.w,raster_y0.l
  move.w d0.w,raster_y1.l
  move.w raster_x0.l,d0.w
  move.w raster_x1.l,d1.w
  move.w d1.w,raster_x0.l
  move.w d0.w,raster_x1.l
.pair_01_ok:
  move.w raster_y1.l,d0.w
  cmp.w raster_y2.l,d0.w
  ble.s .pair_12_ok
  move.w raster_y2.l,d1.w
  move.w d1.w,raster_y1.l
  move.w d0.w,raster_y2.l
  move.w raster_x1.l,d0.w
  move.w raster_x2.l,d1.w
  move.w d1.w,raster_x1.l
  move.w d0.w,raster_x2.l
.pair_12_ok:
  move.w raster_y0.l,d0.w
  cmp.w raster_y1.l,d0.w
  ble.s .sorted
  move.w raster_y1.l,d1.w
  move.w d1.w,raster_y0.l
  move.w d0.w,raster_y1.l
  move.w raster_x0.l,d0.w
  move.w raster_x1.l,d1.w
  move.w d1.w,raster_x0.l
  move.w d0.w,raster_x1.l
.sorted:
  move.w raster_y2.l,d1.w
  sub.w raster_y0.l,d1.w
  beq.w .done

  // Long edge slope in Q10.6; one division for the whole edge.
  move.w raster_x2.l,d0.w
  sub.w raster_x0.l,d0.w
  ext.l d0.l
  lsl.l #6,d0.l
  divs.w d1.w,d0.l
  move.w d0.w,long_edge_slope.l

  move.w raster_x0.l,d0.w
  ext.l d0.l
  lsl.l #6,d0.l
  move.l d0.l,long_edge_origin.l

  // Upper half: long edge x0->x2 against short edge x0->x1.
  move.w raster_y1.l,d1.w
  sub.w raster_y0.l,d1.w
  beq.s .lower_half
  move.w raster_x1.l,d0.w
  sub.w raster_x0.l,d0.w
  ext.l d0.l
  lsl.l #6,d0.l
  divs.w d1.w,d0.l
  move.w d0.w,half_slope_b.l
  move.w long_edge_slope.l,half_slope_a.l
  move.l long_edge_origin.l,half_x_a.l
  move.l long_edge_origin.l,half_x_b.l
  move.w raster_y0.l,half_start_y.l
  move.w raster_y1.l,half_end_y.l
  bsr.w raster_half

.lower_half:
  // Lower half: advance the long edge to y1 and walk x1->x2.
  move.w raster_y2.l,d1.w
  sub.w raster_y1.l,d1.w
  beq.w .done
  move.w raster_x2.l,d0.w
  sub.w raster_x1.l,d0.w
  ext.l d0.l
  lsl.l #6,d0.l
  divs.w d1.w,d0.l
  move.w d0.w,half_slope_b.l
  move.w long_edge_slope.l,half_slope_a.l

  move.w raster_y1.l,d0.w
  sub.w raster_y0.l,d0.w
  move.w long_edge_slope.l,d1.w
  muls.w d0.w,d1.l
  add.l long_edge_origin.l,d1.l
  move.l d1.l,half_x_a.l
  move.w raster_x1.l,d0.w
  ext.l d0.l
  lsl.l #6,d0.l
  move.l d0.l,half_x_b.l
  move.w raster_y1.l,half_start_y.l
  move.w raster_y2.l,half_end_y.l
  bsr.w raster_half
.done:
  movem.l (sp)+,d0-d7/a0-a3
]

// Two Q10.6 edge walkers; clipping advances both accumulators before drawing.
[raster_half
  movem.l d0-d7/a0-a6,-(sp)
  move.w half_start_y.l,d0.w
  move.w half_end_y.l,d1.w
  cmpi.w #0,d1.w
  ble.w .done
  cmp.w render_size.l,d0.w
  bge.w .done
  move.l half_x_a.l,d4.l
  move.l half_x_b.l,d5.l
  move.w half_slope_a.l,d6.w
  ext.l d6.l
  move.w half_slope_b.l,d7.w
  ext.l d7.l
  tst.w d0.w
  bge.s .top_clipped
  move.w d0.w,d2.w
  neg.w d2.w
  move.l d6.l,d3.l
  muls.w d2.w,d3.l
  add.l d3.l,d4.l
  move.l d7.l,d3.l
  muls.w d2.w,d3.l
  add.l d3.l,d5.l
  clr.w d0.w
.top_clipped:
  cmp.w render_size.l,d1.w
  ble.s .bottom_clipped
  move.w render_size.l,d1.w
.bottom_clipped:
  cmp.w d1.w,d0.w
  bge.w .done
  // Current clipped model envelope fits signed Q16.16. Multiplication by 1024
  // retains every original Q10.6 step; no extra precision or rounding is added.
  lsl.l #8,d4.l
  lsl.l #2,d4.l
  lsl.l #8,d5.l
  lsl.l #2,d5.l
  lsl.l #8,d6.l
  lsl.l #2,d6.l
  lsl.l #8,d7.l
  lsl.l #2,d7.l
  move.w d0.w,scan_y.l
  move.w d1.w,scan_end.l
  moveq #0,d2.l
  move.w d0.w,d2.w
  mulu.w render_stride.l,d2.l
  move.l draw_vram_base.l,a4
  adda.l d2.l,a4
  moveq #0,d2.l
  move.w d1.w,d2.w
  mulu.w render_stride.l,d2.l
  move.l draw_vram_base.l,a3
  adda.l d2.l,a3
  move.w d0.w,d2.w
  add.w d2.w,d2.w
  move.l dirty_left_pointer.l,a5
  move.l dirty_right_pointer.l,a6
  adda.w d2.w,a5
  adda.w d2.w,a6
  move.w triangle_color.l,d2.w
  swap d2.l
  move.w triangle_color.l,d2.w
  move.l d2.l,a2
  lea .burst_end(pc),a1
.scanline:
  bsr.w service
  move.l d4.l,d0.l
  swap d0.l
  move.l d5.l,d1.l
  swap d1.l
  cmp.w d1.w,d0.w
  ble.s .ordered
  exg d0.l,d1.l
.ordered:
  cmpi.w #0,d0.w
  bge.s .left_clipped
  clr.w d0.w
.left_clipped:
  cmp.w render_size.l,d1.w
  ble.s .right_clipped
  move.w render_size.l,d1.w
.right_clipped:
  cmp.w d1.w,d0.w
  bge.w .advance_edges

  // Accumulate the union of all triangle spans for this scanline. It becomes
  // the exact dirty region cleared at the beginning of the next frame.
  cmp.w (a5),d0.w
  bge.s .dirty_left_ok
  move.w d0.w,(a5)
.dirty_left_ok:
  cmp.w (a6),d1.w
  ble.s .dirty_right_ok
  move.w d1.w,(a6)
.dirty_right_ok:
  // Per-span diagnostics are disabled in this hot path. Their status fields
  // remain zero; visible-face/frame counters and all image state are retained.
  sub.w d0.w,d1.w
  move.l a4,a0
  add.w d0.w,d0.w
  adda.w d0.w,a0
  move.l a2,d2.l
  btst #0,d1.l
  beq.s .pairs
  move.w d2.w,(a0)+
.pairs:
  lsr.w #1,d1.w
  move.w d1.w,d0.w
  andi.w #7,d0.w
  add.w d0.w,d0.w
  neg.w d0.w
  lsr.w #3,d1.w
  // Enter at the remainder, then loop over full 16-pixel bursts.
  jmp 0(a1,d0.w)
.burst:
  move.l d2.l,(a0)+
  move.l d2.l,(a0)+
  move.l d2.l,(a0)+
  move.l d2.l,(a0)+
  move.l d2.l,(a0)+
  move.l d2.l,(a0)+
  move.l d2.l,(a0)+
  move.l d2.l,(a0)+
.burst_end:
  dbra d1.w,.burst

.advance_edges:
  add.l d6.l,d4.l
  add.l d7.l,d5.l
  adda.w render_stride.l,a4
  addq.l #2,a5
  addq.l #2,a6
  cmpa.l a3,a4
  blt.w .scanline
.done:
  movem.l (sp)+,d0-d7/a0-a6
]

[demo_data
current_angle:
  defw 0
draw_page:
  defw 1
draw_vram_base:
  defl VRAM_PAGE_1
dirty_left_pointer:
  defl 0
dirty_right_pointer:
  defl 0
page_bounds:
  defw SCREEN_HEIGHT,0,SCREEN_HEIGHT,0
have_previous_bounds:
  defw 0
current_min_x:
  defw 0
current_max_x:
  defw 0
current_min_y:
  defw 0
current_max_y:
  defw 0
previous_min_x:
  defw 0
previous_max_x:
  defw 0
previous_min_y:
  defw 0
previous_max_y:
  defw 0
vertices_left:
  defw 0
faces_left:
  defw 0
face_index:
  defw 0
tmp_x:
  defw 0
tmp_y:
  defw 0
tmp_z:
  defw 0
tmp_x1:
  defw 0
tmp_z1:
  defw 0
tmp_y2:
  defw 0
tmp_depth:
  defw 0
scan_y:
  defw 0
scan_end:
  defw 0
span_left:
  defw 0
span_right:
  defw 0
edge_hits:
  defw 0
triangle_color:
  defw 0
raster_x0:
  defw 0
raster_y0:
  defw 0
raster_x1:
  defw 0
raster_y1:
  defw 0
raster_x2:
  defw 0
raster_y2:
  defw 0
long_edge_slope:
  defw 0
long_edge_origin:
  defl 0
half_start_y:
  defw 0
half_end_y:
  defw 0
half_slope_a:
  defw 0
half_slope_b:
  defw 0
half_x_a:
  defl 0
half_x_b:
  defl 0
triangle_points:
  align 2
  defw 0,0,0,0,0,0

]/

[rich_assets
sine_table:
  defw 0,402,804,1205,1606,2006,2404,2801,3196,3590,3981,4370,4756,5139,5520,5897,6270,6639,7005,7366,7723,8076,8423,8765
  defw 9102,9434,9760,10080,10394,10702,11003,11297,11585,11866,12140,12406,12665,12916,13160,13395,13623,13842,14053,14256,14449,14635,14811,14978
  defw 15137,15286,15426,15557,15679,15791,15893,15986,16069,16143,16207,16261,16305,16340,16364,16379,16384,16379,16364,16340,16305,16261,16207,16143
  defw 16069,15986,15893,15791,15679,15557,15426,15286,15137,14978,14811,14635,14449,14256,14053,13842,13623,13395,13160,12916,12665,12406,12140,11866
  defw 11585,11297,11003,10702,10394,10080,9760,9434,9102,8765,8423,8076,7723,7366,7005,6639,6270,5897,5520,5139,4756,4370,3981,3590
  defw 3196,2801,2404,2006,1606,1205,804,402,0,-402,-804,-1205,-1606,-2006,-2404,-2801,-3196,-3590,-3981,-4370,-4756,-5139,-5520,-5897

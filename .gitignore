# Host-specific toolchains and generated output must not enter this repository.
build/
dist/
work/
*.X
*.o
*.m68k-gas.s
lk_tmp/

# Local media images can be large and may contain licensed system software.
*.xdf
*.hds
*.hdf

# XEiJ is a local development dependency. Its official distribution expands to
# about 790 MB, so it is fetched reproducibly but never committed or shipped.
tools/third_party/xeij/XEiJ-*/
tools/third_party/xeij/XEiJ_*.zip

# Editor / operating-system files
.vscode/
.idea/
Thumbs.db
.DS_Store

# Host-side assembler build output
tools/m68kasm/src/M68kAsm/bin/
tools/m68kasm/src/M68kAsm/obj/
